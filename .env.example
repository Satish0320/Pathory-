# Copy to .env.local for development. Never commit the filled-in version.

# --- Supercell Clash of Clans API ---
# Generate at https://developer.clashofclans.com — token is IP-locked to whatever
# IP you register it against. See .claude/rules/api.md before touching this.
COC_API_TOKEN=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/clash_command_dev

# --- Auth (Clerk — web now, Expo/mobile in Phase 2, same account system) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Base screenshot CV fallback (Roboflow-hosted inference) ---
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ENDPOINT=

# --- Cache layer (optional in Phase 1 dev; in-memory Map is fine locally) ---
# REDIS_URL=
