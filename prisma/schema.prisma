// Prisma schema — implements the "shared data spine" principle from CLAUDE.md §4.
// Phase 1 only builds UI/endpoints for Users, Players, Attacks, and SkillProfiles.
// clanTag/warTag fields exist now so Phase 2 (War Room) is a read model over
// this same data, not a schema migration. Do not build Phase 2 UI against them yet.
//
// Prisma 7+: the client is Rust-free and requires an explicit driver adapter
// (@prisma/adapter-pg for Postgres) passed to `new PrismaClient({ adapter })`
// in lib/db.ts — this is a constructor-level change, not a schema change, but
// worth noting here since it trips people upgrading from Prisma 5/6 muscle
// memory. Also: `prisma migrate dev` no longer auto-runs `prisma generate` as
// of v7 — run it explicitly after every schema change (see README.md).

// Connection URL lives in prisma.config.ts (Prisma 7+ no longer supports
// `url` here) — the CLI reads it from there for migrate/generate, while
// lib/db.ts passes its own adapter to PrismaClient at runtime.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// The authenticated account (Clerk) — deliberately separate from Player.
// See .claude/skills/authentication/SKILL.md: one signed-in person can have
// multiple in-game accounts/alts, so this is a one-to-many relation, not 1:1.
// A player tag is public game data and must never be treated as an auth
// credential — this model is what actually gates access, per CLAUDE.md §3.
model User {
  id        String   @id // Clerk user ID — do not generate our own, use theirs directly
  email     String?  @unique // optional: Clerk can auth via OAuth with no email surfaced
  createdAt DateTime @default(now())

  players Player[]

  // Cascade: deleting a User must cleanly remove everything below per
  // .claude/rules/legal-compliance.md §3 (right to deletion) — this is the
  // top of that cascade chain.
}

model Player {
  id           String   @id @default(cuid())
  playerTag    String   @unique // official Supercell tag, e.g. "#ABC123" — the real key, not an internal-only ID
  name         String // in-game name, pulled from the Supercell API — not user-editable
  label        String? // user's own nickname for this account, e.g. "War Alt", "Farm #3" — see .claude/skills/authentication/SKILL.md's multi-account section. Matters once a user has more than 2-3 accounts and playerTag/name alone stop being distinguishable at a glance.
  isPrimary    Boolean  @default(false) // which account loads by default (dashboard, attack planner) — see authentication/SKILL.md. Exactly one true per User; enforce in application logic, not a DB constraint (Postgres can't easily express "at most one true per userId" without a partial unique index, and a stale index here isn't worth the complexity Phase 1 needs).
  townHallLvl  Int
  lastSyncedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  attacks      Attack[]
  skillProfile SkillProfile?

  createdAt DateTime @default(now())

  @@index([userId]) // every "list this user's accounts" query filters on this — see authentication/SKILL.md's switcher pattern
}

model Attack {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  // Base intake
  baseSourceType String // "link" | "screenshot_cv"
  baseTownHall   Int
  baseSnapshot   Json   // decoded building positions/levels at time of attack

  // Recommendation (kept structured per .claude/skills/recommendation-engine/SKILL.md)
  recommendedStrategy String
  reasoningFactors    Json  // array of {factor, detail, weight}
  confidenceScore     Float

  // Outcome (self-reported — see .claude/rules/api.md: no replay data exists)
  starsEarned     Int?
  mistakeCategory String? // "early_deployment" | "poor_funnel" | "late_ability" | "spell_mistiming" | "split_army" | "slow_cleanup" | null
  armySplit       Boolean?

  // Present now, unused until Phase 2 — do not build War Room features against these yet
  clanTag String?
  warTag  String?

  createdAt DateTime @default(now())
}

model SkillProfile {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String @unique

  funnelScore  Float @default(0)
  timingScore  Float @default(0)
  cleanupScore Float @default(0)
  overallScore Float @default(0)

  attackCount Int      @default(0) // used to weight confidence — see recommendation-engine skill
  updatedAt   DateTime @updatedAt
}
